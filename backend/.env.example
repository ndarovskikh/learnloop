# Agent 1 — main coach: picks/asks questions, drives the session.
OPENAI_API_KEY=insert api key here
OPENAI_MODEL=mimo-v2.5-free
OPENAI_BASE_URL=https://opencode.ai/zen/v1
MAX_AGENT_STEPS=12
MAX_TOPIC_DEPTH=5
MAX_EXTRA_TOPIC_ITERATIONS=1

# Agent 2 — "Andrew": validates a student's answer and scores it.
# Leave unset to fall back to the agent 1 key/model/base URL above.
LEARNLOOP_VALIDATOR_API_KEY=
LEARNLOOP_VALIDATOR_MODEL=
LEARNLOOP_VALIDATOR_BASE_URL=

# Agent 3 — "Liza": grows the personal question bank from progress gaps
# (runs nightly and when a student hits the topic depth limit).
LEARNLOOP_QUESTION_BANK_API_KEY=
LEARNLOOP_QUESTION_BANK_MODEL=
LEARNLOOP_QUESTION_BANK_BASE_URL=

# Agent 4 — "Danya", the superior/statistics agent. Reserved for symmetry;
# its percentile is deliberately computed by deterministic SQL, not an LLM,
# so this key is not called today. See docs/admin-agent-boundary.md.
LEARNLOOP_SUPERIOR_API_KEY=
LEARNLOOP_SUPERIOR_MODEL=
LEARNLOOP_SUPERIOR_BASE_URL=

# Agent 5 — "Natali": reacts when a teacher publishes new course material.
LEARNLOOP_MATERIAL_API_KEY=
LEARNLOOP_MATERIAL_MODEL=
LEARNLOOP_MATERIAL_BASE_URL=

# Optional: required to call POST /api/admin/benchmark directly (not needed
# for the in-chat "how do I compare to others" flow, which agent 1 already
# routes to agent 4 for the requester's own percentile).
LEARNLOOP_ADMIN_TOKEN=

# Optional: if set, POST /api/teacher/materials requires this value in an
# X-Teacher-Token header. Left empty for the demo's "teacher" account login.
LEARNLOOP_TEACHER_TOKEN=
